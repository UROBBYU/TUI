{
	"include": ["src/**/*.ts"],
	"exclude": [""],
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,
		"types": ["node"],
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmitOnError": true,
		"strict": true,
		"declaration": true
	}
}
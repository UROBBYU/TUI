{
	"include": ["src/**/*.ts"],
	"exclude": [""],
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"target": "es5",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": { "@urobbyu/tui/ts": ["./src/ts/v5.1.d.ts"] },
		"types": ["node"],
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmitOnError": true,
		"strict": true,
		"declaration": true
	}
}
{
	"name": "@urobbyu/tui",
	"version": "0.3.4",
	"description": "Simple Text-based User Interface system for terminal applications",
	"author": "Robert Liapota <urobbyu@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UROBBYU/TUI.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"scripts": {
		"prebuild": "node-gyp rebuild && shx cp build/Release/winfix.node src/ && shx rm -rf build",
		"build": "tsc",
		"postbuild": "shx cp src/keys.json src/winfix.node dist/",
		"clear": "shx rm -rf dist/",
		"build-gyp": "npm run prebuild"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"@types/node": "^22.10.1",
		"node-addon-api": "^8.3.0",
		"shx": "^0.4.0"
	},
	"files": ["*"],
	"keywords": [
		"tui",
		"cli"
	]
}
